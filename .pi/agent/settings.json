{
  "lastChangelogVersion": "0.84.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "showHardwareCursor": false,
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-markdown-preview",
    "npm:@juicesharp/rpiv-btw",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": []
    },
    "npm:pi-mermaid",
    "npm:pi-web-access",
    "npm:pi-prompt-shelf",
    "npm:@latentminds/pi-quotas",
    "npm:@aliou/pi-processes",
    "npm:@zenobius/pi-worktrees",
    "npm:pi-tmux-window-name",
    {
      "source": "https://github.com/aspiers/pi-status@fix/pi-status-title-renames",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "npm:@vanillagreen/pi-skills-manager",
    "npm:@vanillagreen/pi-session-manager",
    "npm:@vanillagreen/pi-extension-manager",
    "npm:pi-resource-center",
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:@tmustier/pi-session-recap",
    "npm:@brain0pia/pi-extension-times",
    "git:github.com/apmantza/pi-lens",
    {
      "source": "npm:@lukemelnik/pi-monitor",
      "extensions": []
    },
    "npm:pi-peek",
    "npm:@gotgenes/pi-github-tools",
    "npm:@gotgenes/pi-autoformat",
    "npm:@spences10/pi-skill-importer",
    "git:github.com/aspiers/pi-ask-user@working",
    "npm:@mzwing/pi-permission-auto-review",
    "git:github.com/aspiers/pi-herdr-tab-sync@fix/immediate-name-sync",
    "npm:pi-model-aware-compaction@0.1.5",
    "../../.GIT/3rd-party/pi-packages/packages/pi-permission-system",
    "npm:@gotgenes/pi-subagents@19.2.1",
    "npm:@gotgenes/pi-subagents-worktrees@0.2.3",
    "git:github.com/aspiers/pi-shortcuts@configurable-shortcut",
    "npm:@jmfederico/pi-web@1.202608.1"
  ],
  "hideThinkingBlock": false,
  "powerline": {
    "preset": "ascii",
    "fixedEditor": false
  },
  "enableSkillCommands": true,
  "treeFilterMode": "user-only",
  "piStatus": {
    "separator": " ",
    "components": [
      {
        "id": "spinner",
        "enabled": true
      },
      {
        "id": "pi_symbol",
        "enabled": false
      },
      {
        "id": "session",
        "enabled": true
      },
      {
        "id": "cwd",
        "enabled": false
      },
      {
        "id": "model",
        "enabled": false
      },
      {
        "id": "thinking",
        "enabled": false
      },
      {
        "id": "tokens",
        "enabled": false
      },
      {
        "id": "turn",
        "enabled": false
      },
      {
        "id": "git_branch",
        "enabled": false
      },
      {
        "id": "tools_count",
        "enabled": false
      },
      {
        "id": "current_tool",
        "enabled": false
      }
    ],
    "ghosttySupport": true
  },
  "vstack": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-session-manager": {
          "shortcutKey": "alt+m"
        }
      },
      "disabledItems": [
        "package:pi-agent-browser-native"
      ]
    }
  },
  "steeringMode": "all",
  "compaction": {
    "enabled": true,
    "reserveTokens": 9000,
    "keepRecentTokens": 20000
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen"
}