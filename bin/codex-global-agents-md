#!/usr/bin/env bash
#
# Build ~/.codex/AGENTS.md from an output-style body plus the shared global
# rules in ~/.agents/AGENTS.md.
#
# Claude Code, Pi and OpenCode can each load the shared rules file alongside
# the style. Codex cannot: it reads a single global AGENTS.md and has no
# include syntax or setting for extra instruction files. So the two sources
# are concatenated here, and the result goes stale until this is re-run.
#
# Usage: codex-global-agents-md [STYLE_BODY]
#
# Without STYLE_BODY, the style recorded in the existing file is reused (or
# the target of a symlinked one), so re-running after editing the rules keeps
# whichever style bin/attention-span-install last selected.

set -euo pipefail

codex_dir="${CODEX_HOME:-$HOME/.codex}"
rules="${AGENTS_GLOBAL_RULES:-$HOME/.agents/AGENTS.md}"
out="$codex_dir/AGENTS.md"
marker='<!-- Generated by codex-global-agents-md from style:'

die() { printf 'codex-global-agents-md: %s\n' "$*" >&2; exit 1; }
note() { printf '  %s\n' "$*"; }

if [ ! -d "$codex_dir" ]; then
    note "skipped, no $codex_dir"
    exit 0
fi

[ -f "$rules" ] || die "no shared rules file at $rules"

recorded_style() {
    if [ -L "$out" ]; then
        # The pre-concatenation setup symlinked the style body directly.
        local target
        target=$(readlink -f "$out")
        [ "$target" = "$(readlink -f "$rules")" ] || printf '%s\n' "$target"
    elif [ -f "$out" ]; then
        sed -n "1s|^$marker \\(.*\\) -->\$|\\1|p" "$out"
    fi
}

style=${1:-$(recorded_style)}
[ -z "$style" ] || [ -f "$style" ] || die "no style body at $style"

tmp=$(mktemp "$out.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
    if [ -n "$style" ]; then
        printf '%s %s -->\n\n' "$marker" "$style"
        cat "$style"
        printf '\n'
    fi
    cat "$rules"
} > "$tmp"
chmod 644 "$tmp"
# rename(2) replaces a symlink itself rather than writing through it.
mv -f "$tmp" "$out"
trap - EXIT

note "$out <- ${style:-(no style)} + $rules"
