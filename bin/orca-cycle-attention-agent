#!/usr/bin/env python3
"""Focus the previous or next Orca agent that requires attention.

Orca has no keybinding action that jumps to an agent needing input
(stablyai/orca#12577), and its keybindings cannot run shell commands, so
this helper is meant to be bound to a desktop-level hotkey instead. It
reads agent states from ``orca worktree ps``, maps each agent's pane to a
terminal handle via ``orca terminal list``, and reveals the chosen pane with
``orca terminal switch``.

Candidates are ordered like Orca's own "Smart" sidebar sort: agents that are
blocked or waiting for input first, then agents that finished recently, each
group newest first. Interrupted completions and completions older than the
staleness window are ignored, again matching Orca.
"""

from __future__ import annotations

import argparse
import json
import time
from pathlib import Path
from typing import Any

from orca_cli import (
    LISTING_LIMIT,
    focused_pane_keys,
    log_line,
    run_orca,
    terminal_handles,
)

CLIENT = "orca-cycle-attention-agent"
ATTENTION_PRIORITY = {"blocked": 2, "waiting": 2, "done": 1}
# Mirrors Orca's AGENT_STATUS_STALE_AFTER_MS: a completion older than this
# has aged out of the sidebar's "done" class, so it stops being attention.
DONE_STALE_AFTER_MS = 30 * 60 * 1000


def needs_attention(agent: dict[str, Any], now_ms: int) -> bool:
    state = agent.get("state")
    if state not in ATTENTION_PRIORITY:
        return False
    if state != "done":
        return True
    if agent.get("interrupted"):
        return False
    # `worktree ps` exposes no completion timestamp, but a `done` row's
    # stateStartedAt is when the turn completed.
    started = agent.get("stateStartedAt")
    return isinstance(started, (int, float)) and now_ms - started <= DONE_STALE_AFTER_MS


def attention_agents(
    worktrees: list[dict[str, Any]], now_ms: int
) -> list[dict[str, Any]]:
    candidates = [
        agent
        for worktree in worktrees
        for agent in worktree.get("agents", [])
        if needs_attention(agent, now_ms)
    ]
    return sorted(
        candidates,
        key=lambda agent: (
            -ATTENTION_PRIORITY[agent["state"]],
            -agent.get("stateStartedAt", 0),
        ),
    )


def target_agent(
    candidates: list[dict[str, Any]], focused: set[str], direction: str
) -> dict[str, Any] | None:
    if not candidates:
        return None
    current_index = next(
        (
            index
            for index, agent in enumerate(candidates)
            if agent["paneKey"] in focused
        ),
        None,
    )
    if current_index is None:
        target_index = 0 if direction == "next" else len(candidates) - 1
    elif direction == "next":
        target_index = (current_index + 1) % len(candidates)
    else:
        target_index = (current_index - 1) % len(candidates)
    return candidates[target_index]


def cycle_attention_agent(direction: str, now_ms: int | None = None) -> str | None:
    """Reveal the target agent's pane and return its terminal handle, if any.

    Returns None when no agent needs attention. Logs one line describing the
    decision, since hotkey runs usually have no visible stdout or stderr.
    """
    if now_ms is None:
        now_ms = int(time.time() * 1000)
    ps = run_orca(["worktree", "ps", "--limit", LISTING_LIMIT])
    listing = run_orca(
        ["terminal", "list", "--include-visual-layouts", "--limit", LISTING_LIMIT]
    )
    worktrees = ps.get("worktrees", [])
    handles = terminal_handles(listing.get("terminals", []))
    # An agent row whose pane no longer has a live terminal cannot be focused.
    candidates = [
        agent
        for agent in attention_agents(worktrees, now_ms)
        if agent.get("paneKey") in handles
    ]
    focused = focused_pane_keys(worktrees, listing.get("visualLayouts", []))
    target = target_agent(candidates, focused, direction)
    if target is None:
        log(f"{direction}: no agent needs attention")
        return None
    handle = handles[target["paneKey"]]
    focus = run_orca(["terminal", "switch", "--terminal", handle]).get("focus", {})
    log(
        f"{direction}: {len(candidates)} candidate(s), "
        f"{'already focused' if target['paneKey'] in focused else 'switching to'} "
        f"{target.get('state')} {target.get('agentType')} {handle} "
        f"navigated={focus.get('navigated')}"
    )
    return handle


LOG_PATH: Path | None = None


def log(message: str) -> None:
    log_line(CLIENT, message, LOG_PATH)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("direction", choices=("previous", "next"))
    parser.add_argument(
        "--log",
        type=Path,
        metavar="FILE",
        help="also append each run's outcome to FILE (for hotkey runs whose "
        "stderr is discarded)",
    )
    return parser.parse_args()


def main() -> int:
    global LOG_PATH
    args = parse_args()
    LOG_PATH = args.log
    try:
        cycle_attention_agent(args.direction)
    except (KeyError, OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        log(f"{args.direction}: {error}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
