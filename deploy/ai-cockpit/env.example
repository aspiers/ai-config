# Public-safe variable inventory for the portable AI cockpit.
# Copy to ~/.config/ai-cockpit/runtime.env and replace placeholders locally.
# Never commit the copied file or any secret value.

COCKPIT_IMAGE=replace-with-reviewed-image-reference
COCKPIT_CONTAINER_NAME=ai-cockpit
COCKPIT_UID=replace-with-dedicated-host-uid
COCKPIT_GID=replace-with-dedicated-host-gid
COCKPIT_TIMEZONE=UTC

COCKPIT_HOME_VOLUME=cockpit-home
COCKPIT_HERDR_VOLUME=cockpit-herdr
COCKPIT_COLLIE_VOLUME=cockpit-collie
COCKPIT_AGENTBOX_VOLUME=cockpit-agentbox
COCKPIT_TAILSCALE_VOLUME=cockpit-tailscale
COCKPIT_REPOS_VOLUME=cockpit-repos
COCKPIT_BACKUP_VOLUME=cockpit-backups

COCKPIT_HEALTH_INTERVAL=replace-with-duration
COCKPIT_HEALTH_TIMEOUT=replace-with-duration
COCKPIT_MIN_FREE_BYTES=replace-with-byte-count
COCKPIT_MAX_BACKUP_AGE=replace-with-duration

# Values below are paths to owner-only secret files, not the secrets themselves.
AGENTBOX_PROVIDER_SECRET_FILE=/run/secrets/agentbox-provider
GIT_FORGE_SECRET_FILE=/run/secrets/git-forge
SSH_IDENTITY_SECRET_FILE=/run/secrets/ssh-identity
AI_AGENT_AUTH_SECRET_FILE=/run/secrets/ai-agent-auth
TAILSCALE_AUTH_SECRET_FILE=/run/secrets/tailscale-auth
BACKUP_ENCRYPTION_SECRET_FILE=/run/secrets/backup-encryption
BACKUP_DESTINATION_SECRET_FILE=/run/secrets/backup-destination
COLLIE_TRUSTED_USER_SECRET_FILE=/run/secrets/collie-trusted-user
