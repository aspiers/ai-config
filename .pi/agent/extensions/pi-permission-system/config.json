{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": true,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": true,
  "showPersistenceSummary": true,
  "piInfrastructureReadPaths": [
    "~/.agents/skills"
  ],
  "authorizerChain": [
    "auto-review"
  ],
  "permission": {
    "skill": "allow",
    "bash": {
      "*parcellite*": "deny",
      "*clipit*": "deny",
      "*copyq*": "deny",
      "*greenclip*": "deny",
      "*cliphist*": "deny",
      "*clipman*": "deny",
      "*clipcat*": "deny",
      "*gpaste*": "deny",
      "*GPaste*": "deny",
      "*klipper*": "deny",
      "*diodon*": "deny"
    },
    "path": {
      "*parcellite*": "deny",
      "*clipit*": "deny",
      "*copyq*": "deny",
      "*greenclip*": "deny",
      "*cliphist*": "deny",
      "*clipman*": "deny",
      "*clipcat*": "deny",
      "*gpaste*": "deny",
      "*GPaste*": "deny",
      "*klipper*": "deny",
      "*diodon*": "deny"
    }
  }
}
