#!/usr/bin/env bash
#
# bd-enroll-solo - Enroll a repository into the beads-solo maintainer profile.
#
# Replaces the hand-executed enrollment checklist in the beads-solo skill with
# a deterministic script, so setup is reproducible rather than reconstructed
# probabilistically per session.
#
# Two profiles:
#
#   tracked (default)  The repository owns its Beads enrollment. The marker
#                      and governance files are committed, so every clone and
#                      collaborator inherits the policy.
#
#   --local            The enrollment is invisible to Git. Nothing is staged,
#                      nothing is committed, and no tracked file is modified.
#                      The opt-in lives in --local Git config, the policy
#                      declaration lives in a Beads memory, and every Beads
#                      artifact is excluded via .git/info/exclude.
#
# The --local profile exists for repositories you do not own -- third-party
# checkouts and upstream forks -- where committing .beads-solo and editing a
# tracked AGENTS.md would leak private task tracking into branches and PRs.

set -euo pipefail

YES=false
DRY_RUN=false
LOCAL_MODE=false
CHECK_MODE=false
REPAIR_SKILLS=false
REPAIR_REMOTE=false
REPAIR_PRIME=false
PREFIX=""
ROOT=""
EXCLUDE_FILE=""
BEADS_SKILL_SOURCE=""

# 'git status' as it stood before enrollment. In --local mode the invariant is
# that enrollment leaves it byte-for-byte identical.
STATUS_BEFORE=""

# Memory key for the policy declaration in --local mode. Stable so that
# re-enrolling updates in place rather than accumulating duplicates.
MEMORY_KEY="beads-solo-policy"

# Paths excluded in --local mode. '.beads/' covers the whole workspace: in
# local mode nothing under it is ever published, so a blanket rule is correct
# here even though the tracked profile must never ignore all of .beads.
LOCAL_EXCLUDES=(
    '.beads/'
    '.beads-solo'
)

# Repository-local entry points for the upstream Beads skill. When present,
# these are deliberately excluded even in the tracked profile: newly installed
# entries are absolute symlinks into this machine's Beads checkout and must
# never be published by the enrolled repository. Validation also accepts a
# global installation, so repositories need not duplicate these links.
BEADS_SKILL_LINKS=(
    '.agents/skills/beads'
    '.claude/skills/beads'
)

# bd prime replaces its default workflow text with PRIME.md in the resolved
# workspace. The beads-solo template states this policy and tells agents to
# load the Beads skills before any bd command, which the default text never
# does.
PRIME_NAME="PRIME.md"

# Whether the repository had its own root .gitignore before enrollment.
# 'bd init' creates one; in --local mode that file is ours, not the
# repository's, and must not become visible to Git.
GITIGNORE_PREEXISTING=false

usage() {
    cat <<'EOF'
Usage: bd-enroll-solo [options]

Enroll the current repository into the beads-solo maintainer profile,
initializing Beads in Dolt server mode with push authority withheld.

The script:
  1. verifies prerequisites and that no conflicting enrollment exists
  2. installs repository-local links to the Beads skill
  3. records the opt-in (tracked marker file, or --local Git config)
  4. installs the policy declaration (AGENTS.md, or a Beads memory)
  5. runs bd init --server --role maintainer, then removes the Dolt remote
     it derives from git origin, so Beads state stays on this machine
  6. pins beads.role, configures private JSONL export, installs hooks
  7. installs the beads-solo .beads/PRIME.md, which replaces bd prime's
     default workflow text
  8. verifies the resulting enrollment

Options:
  --check           Validate an existing enrollment instead of creating one.
                    Prints "profile: tracked" or "profile: local" and exits 0
                    when valid; exits 1 when absent or malformed; exits 2
                    when bd cannot open the Beads database, so nothing could
                    be validated. A Dolt remote 'origin' or live sync.remote
                    is checked first and exits 1 even then. This is the
                    only validation the beads-solo skill needs to run.
  --repair-skills   Install or repair only the repository-local Beads skill
                    links and exclusions in an existing enrollment. Requires
                    --yes unless used with --dry-run.
  --repair-remote   Remove the Dolt remote 'origin' and comment out any live
                    sync.remote in .beads/config.yaml, for enrollments made
                    before enrollment removed them. Never pushes and never
                    migrates; if bd refuses because schema migrations are
                    pending, prints the local-only sequence to run first.
                    Requires --yes unless used with --dry-run.
  --repair-prime    Install or refresh .beads/PRIME.md from the beads-solo
                    template in an existing enrollment, replacing any local
                    edits. Staged in the tracked profile; invisible to Git
                    in the local profile. Requires --yes unless used with
                    --dry-run.
  --yes             Actually perform the enrollment. Required unless --dry-run.
  --dry-run         Show the planned values and commands, then exit.
  --local           Enroll invisibly to Git: no tracked files are created or
                    modified, and no Beads artifact is staged. Use for
                    repositories you do not own.
  --prefix PREFIX   Issue prefix. Defaults to the sanitized directory name.
                    Becomes a permanent part of every issue ID.
  -h, --help        Show this help.

The --local profile stores its opt-in in 'git config --local beads.solo.local'
and its policy declaration in a Beads memory keyed 'beads-solo-policy', then
excludes .beads/ and .beads-solo via .git/info/exclude. Because .git/info/
exclude is never published, a clone of the repository sees no trace of it.

Both profiles leave the JSONL export unstaged. They also exclude the local
Beads skill links via .git/info/exclude, because the symlink targets are
machine-specific. Set BEADS_SKILL_DIR to the upstream skill directory when it
cannot be inferred from the local bd installation. Set
BEADS_SOLO_PRIME_TEMPLATE to the PRIME.md template when it is not found
beside this script or in a global beads-solo skill.

Push authorization comes from the installed policy; enrollment does not
configure Beads' 'no-push' guard.
EOF
}

fail() {
    echo "Error: $*" >&2
    exit 1
}

info() {
    echo "==> $*"
}

warn() {
    echo "Warning: $*" >&2
}

quote_cmd() {
    printf '%q ' "$@"
    printf '\n'
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

run() {
    echo "+ $(quote_cmd "$@")"
    if [[ "$DRY_RUN" != true ]]; then
        "$@"
    fi
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes)
                YES=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --local)
                LOCAL_MODE=true
                shift
                ;;
            --check)
                CHECK_MODE=true
                shift
                ;;
            --repair-skills)
                REPAIR_SKILLS=true
                shift
                ;;
            --repair-remote)
                REPAIR_REMOTE=true
                shift
                ;;
            --repair-prime)
                REPAIR_PRIME=true
                shift
                ;;
            --prefix)
                [[ $# -ge 2 ]] || fail "--prefix requires a value"
                PREFIX=$2
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                fail "unknown option: $1"
                ;;
        esac
    done
}

infer_prefix_from_cwd() {
    basename "$ROOT" |
        tr '[:upper:]' '[:lower:]' |
        sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# The policy text installed by both profiles. In tracked mode it is appended
# to AGENTS.md; in local mode it becomes the body of a Beads memory.
policy_text() {
    cat <<'EOF'
## Beads Solo

Before running any `bd` command, load the `beads-solo` (policy), `beads`
(workflow) and `beads-best-practices` (issue writing and updates) skills.

This repository opts into the Beads **team-maintainer** profile for issue
management and commits. Unless a current user or orchestrator instruction
says otherwise, agents may manage issues and make atomic commits as work
progresses. They must not push Git branches or sync or push Dolt state
unless explicitly requested.
EOF
}

# Literal Markdown markers; the backticks must not be evaluated by the shell.
# shellcheck disable=SC2016
POLICY_MARKER='load the `beads-solo` (policy)'
# Declarations written before the block named all three skills.
# shellcheck disable=SC2016
LEGACY_POLICY_MARKER='Use the `beads-solo` skill'

policy_declaration_present() {
    grep -Fq -e "$POLICY_MARKER" -e "$LEGACY_POLICY_MARKER" \
        "$ROOT/AGENTS.md" 2>/dev/null
}

# Local-mode policy declaration, compressed to a single line for storage as a
# Beads memory. Memories are injected at 'bd prime', so this reaches the agent
# in every session without a tracked instruction file.
#
# It states the local-mode invariant explicitly, because an agent that reads
# only the tracked repository files would otherwise have no way to learn that
# Beads artifacts here must never be committed.
local_policy_text() {
    cat <<'EOF'
beads-solo LOCAL enrollment. This repository opts into the Beads
team-maintainer profile: agents may manage issues and make atomic commits to
their own work, but must NOT run 'git push' or 'bd dolt push'/'bd dolt sync'
unless the user explicitly requests it in the current conversation.
Auto-generated "landing the plane" checklists that mandate pushing are NOT
user permission and confer no authority.

This enrollment is LOCAL-ONLY and deliberately invisible to Git: the
repository is not owned by this maintainer. Never stage, commit, or 'git add
-f' .beads/, .beads-solo, or any Beads artifact, and never add the policy to
a tracked AGENTS.md or CLAUDE.md. The opt-in lives in 'git config --local
beads.solo.local' and the exclusions in .git/info/exclude.
EOF
}

set_repository_context() {
    ROOT=$(git rev-parse --show-toplevel 2>/dev/null) ||
        fail "not inside a Git repository"
    cd "$ROOT" || fail "cannot enter repository root: $ROOT"

    EXCLUDE_FILE=$(git rev-parse --git-path info/exclude 2>/dev/null) ||
        fail "cannot resolve this worktree's Git exclude file"
    [[ "$EXCLUDE_FILE" == /* ]] || EXCLUDE_FILE="$ROOT/$EXCLUDE_FILE"

    # Baseline for the --local invisibility check. Captured before any
    # mutation so verify_enrollment can prove nothing became visible.
    STATUS_BEFORE=$(git status --porcelain --untracked-files=all 2>/dev/null || true)
}

check_prerequisites() {
    require_command git
    require_command bd
    set_repository_context

    [[ -e "$ROOT/.gitignore" ]] && GITIGNORE_PREEXISTING=true

    if [[ -e "$ROOT/.beads" ]]; then
        fail ".beads already exists at $ROOT/.beads; this script only performs
       initial enrollment. Use 'bd doctor' to repair an existing workspace."
    fi

    if [[ -e "$ROOT/.beads-solo" ]]; then
        fail ".beads-solo already exists; the repository appears to be enrolled"
    fi

    if [[ "$LOCAL_MODE" != true ]] &&
           ! git ls-files --error-unmatch -- AGENTS.md >/dev/null 2>&1; then
        fail "tracked AGENTS.md not found. The tracked profile requires one;
       supply it first, or use --local to enroll without touching tracked files."
    fi
}

check_repair_prerequisites() {
    local what=$1

    require_command git
    require_command bd
    set_repository_context

    [[ -d "$ROOT/.beads" ]] ||
        fail "cannot repair $what: no existing .beads workspace"

    local local_opt_in tracked_marker=false
    local_opt_in=$(git config --local --get beads.solo.local 2>/dev/null || true)
    git ls-files --error-unmatch -- .beads-solo >/dev/null 2>&1 && tracked_marker=true

    if [[ "$local_opt_in" == true && "$tracked_marker" == true ]]; then
        fail "conflicting enrollment: both local and tracked opt-ins are present"
    elif [[ "$local_opt_in" == true ]]; then
        LOCAL_MODE=true
    elif [[ "$tracked_marker" != true ]]; then
        fail "cannot repair $what: no beads-solo enrollment found"
    fi
}

# A tracked, non-symlink CLAUDE.md that differs from AGENTS.md. Shared by the
# pre-enrollment verification and --check so enrollment can never report
# success on a layout that --check would then reject.
instruction_files_diverged() {
    git ls-files --error-unmatch -- CLAUDE.md >/dev/null 2>&1 || return 1
    [[ -L "$ROOT/CLAUDE.md" ]] && return 1
    ! cmp -s "$ROOT/AGENTS.md" "$ROOT/CLAUDE.md"
}

# In tracked mode a diverged AGENTS.md/CLAUDE.md pair is a policy error: bd
# init writes different platform sections to each, so enrolling would deepen
# the divergence. A symlinked CLAUDE.md is safe and is the recommended layout.
check_instruction_files() {
    [[ "$LOCAL_MODE" == true ]] && return 0

    if [[ ! -e "$ROOT/CLAUDE.md" && ! -L "$ROOT/CLAUDE.md" ]]; then
        return 0
    fi

    if [[ -L "$ROOT/CLAUDE.md" ]]; then
        info "CLAUDE.md is a symlink; managed-section injection is safe"
        return 0
    fi

    git ls-files --error-unmatch -- CLAUDE.md >/dev/null 2>&1 ||
        fail "CLAUDE.md exists but is untracked. 'bd init' would inject
       Claude-only sections into it and stage it, diverging it from
       AGENTS.md. Replace it with a symlink to AGENTS.md, or re-run with
       --local."

    if instruction_files_diverged; then
        fail "tracked AGENTS.md and CLAUDE.md differ. Resolve this first;
       never edit only one file in a diverged pair."
    fi

    fail "AGENTS.md and CLAUDE.md are identical regular files. 'bd init' would
       write different platform sections to each. Replace CLAUDE.md with a
       symlink to AGENTS.md, or re-run with --local."
}

# Without a CLAUDE.md, 'bd init' creates a regular one from its own template,
# which immediately diverges from AGENTS.md and fails --check. Pre-empt that
# with the recommended symlink layout so bd writes into a single file.
ensure_claude_md_symlink() {
    [[ "$LOCAL_MODE" == true ]] && return 0
    [[ -e "$ROOT/CLAUDE.md" || -L "$ROOT/CLAUDE.md" ]] && return 0

    info "Creating CLAUDE.md as a symlink to AGENTS.md"
    run ln -s AGENTS.md "$ROOT/CLAUDE.md"
    run git add -- CLAUDE.md
}

# Append exclusion rules to .git/info/exclude, which is per-clone and never
# published. Idempotent: existing identical rules are left alone.
install_excludes() {
    local description=$1
    shift

    local pattern missing=()

    for pattern in "$@"; do
        if [[ -f "$EXCLUDE_FILE" ]] &&
               grep -qxF "$pattern" "$EXCLUDE_FILE" 2>/dev/null; then
            continue
        fi
        missing+=("$pattern")
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        info "$description exclusions already present in .git/info/exclude"
        return 0
    fi

    info "Excluding $description via .git/info/exclude"

    if [[ "$DRY_RUN" == true ]]; then
        echo "+ # append to .git/info/exclude: ${missing[*]}"
        return 0
    fi

    mkdir -p "$(dirname "$EXCLUDE_FILE")"
    {
        printf '\n# %s (bd-enroll-solo)\n' "$description"
        printf '%s\n' "${missing[@]}"
    } >>"$EXCLUDE_FILE"
}

install_local_excludes() {
    install_excludes "beads-solo local enrollment" "${LOCAL_EXCLUDES[@]}"
}

is_beads_skill() {
    local path=$1
    [[ -f "$path/SKILL.md" ]] &&
        grep -Eq '^name:[[:space:]]*beads[[:space:]]*$' "$path/SKILL.md"
}

skill_path_is_tracked() {
    git ls-files --error-unmatch -- "$1" >/dev/null 2>&1
}

# Print a privacy problem for a skill symlink and return success, or return
# failure when the path is a regular installation or a safe local symlink.
skill_link_privacy_problem() {
    local link=$1
    [[ -L "$ROOT/$link" ]] || return 1

    if skill_path_is_tracked "$link"; then
        local target resolved
        target=$(readlink "$ROOT/$link")
        if [[ "$target" == /* ]]; then
            echo "$link is a tracked absolute symlink to a machine-specific Beads installation"
            return 0
        fi
        resolved=$(cd "$ROOT/$link" 2>/dev/null && pwd -P) || resolved=""
        if [[ "$resolved" != "$ROOT"/* ]]; then
            echo "$link is a tracked symlink resolving outside the repository"
            return 0
        fi
        return 1
    fi
    if ! grep -qxF "$link" "$EXCLUDE_FILE" 2>/dev/null; then
        echo "$link is not listed in this worktree's .git/info/exclude"
        return 0
    fi
    if ! git check-ignore -q --no-index -- "$link" 2>/dev/null; then
        echo "$link is not effectively ignored by Git"
        return 0
    fi

    return 1
}

# Find the upstream skill associated with the installed bd executable. A
# development build retains Go source paths, which lets us locate its checkout
# without baking that machine-specific path into this public script. Packaged
# installations can expose their data under a conventional share directory;
# BEADS_SKILL_DIR is the explicit fallback.
detect_beads_skill_source() {
    local candidate bd_executable source_file source_root
    local candidates=()

    if [[ -n "${BEADS_SKILL_DIR:-}" ]]; then
        is_beads_skill "$BEADS_SKILL_DIR" ||
            fail "BEADS_SKILL_DIR is not a Beads skill directory: $BEADS_SKILL_DIR"
        (cd "$BEADS_SKILL_DIR" && pwd -P)
        return 0
    fi

    bd_executable=$(command -v bd)
    bd_executable=$(readlink -f "$bd_executable" 2>/dev/null || printf '%s' "$bd_executable")

    candidates+=(
        "$(dirname "$bd_executable")/../share/beads/skills/beads"
        "${XDG_DATA_HOME:-$HOME/.local/share}/beads/skills/beads"
        "$HOME/.local/share/beads/skills/beads"
    )

    if command -v strings >/dev/null 2>&1; then
        source_file=$(strings "$bd_executable" 2>/dev/null |
            grep -m1 -E '/cmd/bd/.*\.go$' || true)
        if [[ -n "$source_file" ]]; then
            source_root=${source_file%%/cmd/bd/*}
            candidates+=("$source_root/plugins/beads/skills/beads")
        fi
    fi

    for candidate in "${candidates[@]}"; do
        if is_beads_skill "$candidate"; then
            (cd "$candidate" && pwd -P)
            return 0
        fi
    done

    fail "could not locate the Beads skill shipped with the local bd installation.
       Set BEADS_SKILL_DIR to its directory (the one containing SKILL.md)."
}

prepare_beads_skill_links() {
    local link needs_source=false privacy_problem visible

    for link in "${BEADS_SKILL_LINKS[@]}"; do
        if is_beads_skill "$ROOT/$link"; then
            if skill_path_is_tracked "$link" &&
                   privacy_problem=$(skill_link_privacy_problem "$link"); then
                fail "$privacy_problem"
            fi

            if [[ "$LOCAL_MODE" == true && "$REPAIR_SKILLS" != true ]]; then
                visible=$(git status --porcelain --untracked-files=all -- \
                              "$link" 2>/dev/null || true)
                [[ -z "$visible" ]] ||
                    fail "$link already exists and is visible to Git. Exclude or
       track the existing skill before local enrollment."
            fi
            continue
        fi
        if skill_path_is_tracked "$link"; then
            fail "$link has invalid or missing tracked content; restore or repair
       the repository-owned skill instead of replacing it with a local symlink"
        fi
        if [[ -e "$ROOT/$link" || -L "$ROOT/$link" ]]; then
            if [[ "$REPAIR_SKILLS" == true && -L "$ROOT/$link" ]]; then
                info "Replacing invalid Beads skill symlink at $link"
                needs_source=true
                continue
            fi
            fail "$link exists but is not a valid Beads skill"
        fi
        needs_source=true
    done

    if [[ "$needs_source" == true ]]; then
        BEADS_SKILL_SOURCE=$(detect_beads_skill_source)
        info "Beads skill: $BEADS_SKILL_SOURCE"
    fi
}

has_higher_precedence_ignore_negation() {
    local link=$1 match metadata pattern source
    match=$(git check-ignore -v --no-index -- "$link" 2>/dev/null || true)
    [[ -n "$match" ]] || return 1

    metadata=${match%%$'\t'*}
    pattern=${metadata##*:}
    [[ "$pattern" == '!'* ]] || return 1
    source=${metadata%:*}
    source=${source%:*}

    [[ "$source" == *.gitignore || "$source" == */.gitignore ]]
}

ensure_effective_skill_excludes() {
    local link
    local overridden=()

    # Repository .gitignore rules outrank .git/info/exclude. Detect a negation
    # before changing anything so dry runs are faithful and failures leave no
    # repeated ineffective rules behind.
    for link in "$@"; do
        has_higher_precedence_ignore_negation "$link" &&
            fail "$link cannot be excluded through .git/info/exclude.
       Check for a higher-precedence negation in a repository .gitignore."
    done

    install_excludes "repository-local Beads skill links" "$@"

    # An exact rule may already exist before a later negation. Append it again
    # so the last matching rule always keeps the machine-specific link local.
    for link in "$@"; do
        grep -qxF "$link" "$EXCLUDE_FILE" 2>/dev/null || continue
        git check-ignore -q --no-index -- "$link" 2>/dev/null ||
            overridden+=("$link")
    done
    [[ ${#overridden[@]} -gt 0 ]] || return 0

    info "Restoring effective Git exclusions for repository-local Beads skills"
    if [[ "$DRY_RUN" == true ]]; then
        echo "+ # append to .git/info/exclude: ${overridden[*]}"
        return 0
    fi
    {
        printf '\n# effective repository-local Beads skill links (bd-enroll-solo)\n'
        printf '%s\n' "${overridden[@]}"
    } >>"$EXCLUDE_FILE"
}

verify_planned_skill_excludes() {
    [[ "$DRY_RUN" == true ]] && return 0

    local link
    for link in "$@"; do
        git check-ignore -q --no-index -- "$link" 2>/dev/null ||
            fail "$link cannot be excluded through .git/info/exclude.
       Check for a higher-precedence negation in a repository .gitignore."
    done
}

install_beads_skill_links() {
    local link
    local skill_excludes=()

    # Existing regular skill directories need no exclusion. Missing entries
    # become machine-specific symlinks, and existing symlinks must also remain
    # local to this clone.
    for link in "${BEADS_SKILL_LINKS[@]}"; do
        if [[ ! -e "$ROOT/$link" ]] ||
               { [[ -L "$ROOT/$link" ]] && ! skill_path_is_tracked "$link"; }; then
            skill_excludes+=("$link")
        fi
    done
    if [[ ${#skill_excludes[@]} -gt 0 ]]; then
        ensure_effective_skill_excludes "${skill_excludes[@]}"
        verify_planned_skill_excludes "${skill_excludes[@]}"
    fi

    for link in "${BEADS_SKILL_LINKS[@]}"; do
        if is_beads_skill "$ROOT/$link"; then
            info "Preserving existing Beads skill at $link"
            continue
        fi

        info "Linking $link to the local Beads installation"
        if [[ "$DRY_RUN" == true ]]; then
            [[ -L "$ROOT/$link" ]] && echo "+ rm -f $link"
            echo "+ ln -s $BEADS_SKILL_SOURCE $link"
            continue
        fi

        [[ -L "$ROOT/$link" ]] && rm -f "$ROOT/$link"
        mkdir -p "$(dirname "$ROOT/$link")"
        ln -s "$BEADS_SKILL_SOURCE" "$ROOT/$link"
    done
}

record_opt_in() {
    if [[ "$LOCAL_MODE" == true ]]; then
        info "Recording local opt-in in Git config"
        run git config --local beads.solo.local true
        install_local_excludes
        return 0
    fi

    info "Creating tracked .beads-solo marker"
    if [[ "$DRY_RUN" == true ]]; then
        echo "+ : > .beads-solo"
    else
        : >"$ROOT/.beads-solo"
    fi
    run git add -- .beads-solo
}

install_policy_declaration() {
    if [[ "$LOCAL_MODE" == true ]]; then
        # Deferred until after bd init: 'bd remember' needs a live database.
        return 0
    fi

    if policy_declaration_present; then
        info "Policy declaration already present in AGENTS.md"
        return 0
    fi

    info "Appending policy declaration to AGENTS.md"

    if [[ "$DRY_RUN" == true ]]; then
        echo "+ # append Beads Solo declaration to AGENTS.md"
    else
        {
            printf '\n'
            policy_text
        } >>"$ROOT/AGENTS.md"
    fi

    run git add -- AGENTS.md

    warn "Review AGENTS.md for statements the declaration contradicts,"
    warn "particularly generated 'landing the plane' checklists that mandate"
    warn "pushing. Such text is not user permission and must not be acted on."
}

install_local_memory() {
    [[ "$LOCAL_MODE" == true ]] || return 0

    info "Storing policy declaration as Beads memory '$MEMORY_KEY'"

    if [[ "$DRY_RUN" == true ]]; then
        echo "+ bd remember <local policy> --key $MEMORY_KEY"
        return 0
    fi

    bd remember "$(local_policy_text)" --key "$MEMORY_KEY" ||
        fail "failed to store policy memory; enrollment is incomplete"
}

initialize_workspace() {
    info "Initializing Beads in server mode (prefix: $PREFIX)"

    # --skip-agents in local mode: bd would otherwise write managed sections
    # into tracked instruction files, which local mode must never touch.
    if [[ "$LOCAL_MODE" == true ]]; then
        run bd init --server --role maintainer --skip-agents --prefix "$PREFIX"
    else
        run bd init --server --role maintainer --agents-profile minimal \
            --prefix "$PREFIX"
    fi
}

# URL of the Dolt remote 'origin', or nothing. 'bd dolt remote list' still
# answers while schema migrations are gated, so this works on exactly the
# workspaces that need repair. Before 'bd init' (as in a dry run) there is
# no workspace to list, which means no remote.
dolt_origin_remote_url() {
    { bd dolt remote list 2>/dev/null || true; } |
        awk '$1 == "origin" { print $2; exit }'
}

# Value of an uncommented sync.remote in .beads/config.yaml, or nothing. bd
# resolves its sync target from this key, so a live line keeps the workspace
# pointed at the remote even after the Dolt remote itself is gone.
live_sync_remote() {
    sed -nE '/^[[:space:]]*sync\.remote:/ {
        s/^[[:space:]]*sync\.remote:[[:space:]]*//
        p
        q
    }' "$ROOT/.beads/config.yaml" 2>/dev/null || true
}

# Print one problem per line for any remote beads-solo must not have. Shared
# by enrollment verification and --check. It never opens the Beads database,
# so --check can run it before the checks that do.
dolt_remote_problems() {
    local url
    url=$(dolt_origin_remote_url)
    [[ -z "$url" ]] ||
        echo "a Dolt remote 'origin' is still configured ($url); beads-solo keeps Beads state on this machine. Run 'bd-enroll-solo --repair-remote --yes'"
    url=$(live_sync_remote)
    [[ -z "$url" ]] ||
        echo "sync.remote is still set in .beads/config.yaml ($url). Run 'bd-enroll-solo --repair-remote --yes'"
}

# Printed when bd refuses to remove the remote because its own presence makes
# the database look shared. Everything here stays on this machine: the
# refusal protects clones that do not exist, so migrating in place is safe.
migration_gate_advice() {
    local url=$1 backup
    backup=".beads/backup/pre-migrate-$(date +%Y%m%d-%H%M%S).jsonl"
    cat >&2 <<EOF
Error: bd refused to remove the Dolt remote 'origin' ($url)
       because schema migrations are pending, and bd will not migrate a
       database it believes is remote-backed. That remote is an enrollment
       defect -- bd init derived it from git origin -- not a sync setup.
       Nothing was removed.

Migrate locally, then remove the remote. None of these steps pushes:

  bd export --all -o $backup
  bd dolt commit
  bd migrate --force
  bd dolt remote remove origin

or rerun 'bd-enroll-solo --repair-remote --yes' in place of the last step.

Do NOT run 'bd dolt push' or 'bd bootstrap': the remote is $url,
so either would publish or pull private Beads state through it.
EOF
}

# 'bd init' wires git origin as the Dolt remote 'origin' (and persists
# sync.remote), which in a third-party checkout is the upstream project.
# beads-solo keeps Beads state on this machine, so undo it.
remove_dolt_origin_remote() {
    local url output
    url=$(dolt_origin_remote_url)
    if [[ "$DRY_RUN" != true && -z "$url" ]]; then
        info "No Dolt remote 'origin' is configured"
        return 0
    fi

    info "Removing the Dolt remote 'origin'${url:+ ($url)}"
    echo "+ $(quote_cmd bd dolt remote remove origin)"
    [[ "$DRY_RUN" == true ]] && return 0

    if output=$(bd dolt remote remove origin 2>&1); then
        [[ -z "$output" ]] || printf '%s\n' "$output"
        return 0
    fi

    printf '%s\n' "$output" >&2
    if grep -Eq 'refusing to (auto-apply|migrate)' <<<"$output"; then
        migration_gate_advice "${url:-origin}"
        exit 1
    fi
    fail "could not remove the Dolt remote 'origin'"
}

# Comment the key out rather than deleting it, as 'bd config unset' does, so
# the old value stays visible for review. Doing this before removing the Dolt
# remote also stops 'bd dolt remote remove' from staging and committing
# config.yaml itself, which would sweep in whatever else is staged.
disable_sync_remote() {
    local url
    url=$(live_sync_remote)
    if [[ -z "$url" ]]; then
        info "No live sync.remote in .beads/config.yaml"
        return 0
    fi

    info "Commenting out sync.remote ($url) in .beads/config.yaml"
    if [[ "$DRY_RUN" == true ]]; then
        echo "+ # comment out sync.remote in .beads/config.yaml"
        return 0
    fi
    sed -i -E 's/^([[:space:]]*)(sync\.remote:)/\1# \2/' "$ROOT/.beads/config.yaml"
}

# 'bd init' creates a root .gitignore holding its canonical ignore rules. In
# --local mode that file is an artifact of our private enrollment, not the
# repository's own policy, so leaving it would break invisibility -- it shows
# up as an untracked file, or worse, edits a .gitignore the project tracks.
#
# When the repository had no .gitignore, fold bd's rules into
# .git/info/exclude and remove the file. When it already had one, bd may have
# appended to it; that is a tracked-file modification we must not make, so
# restore the original content from Git and re-home the rules.
absorb_bd_gitignore() {
    [[ "$LOCAL_MODE" == true ]] || return 0

    local gitignore="$ROOT/.gitignore"

    if [[ "$DRY_RUN" == true ]]; then
        echo "+ # fold any bd-created .gitignore into .git/info/exclude"
        return 0
    fi

    [[ -e "$gitignore" ]] || return 0

    if [[ "$GITIGNORE_PREEXISTING" != true ]]; then
        info "Folding bd's .gitignore into .git/info/exclude"
        {
            printf '\n# beads-solo local enrollment: rules from bd init\n'
            cat "$gitignore"
        } >>"$EXCLUDE_FILE"
        rm -f "$gitignore"
        return 0
    fi

    # Pre-existing .gitignore: only act if bd actually modified it.
    git diff --quiet -- .gitignore 2>/dev/null && return 0

    info "Reverting bd's changes to the pre-existing .gitignore"

    local added
    added=$(git diff --unified=0 -- .gitignore 2>/dev/null |
                sed -n 's/^+\([^+].*\)$/\1/p' || true)

    if [[ -n "$added" ]]; then
        {
            printf '\n# beads-solo local enrollment: rules from bd init\n'
            printf '%s\n' "$added"
        } >>"$EXCLUDE_FILE"
    fi

    git checkout -- .gitignore ||
        fail "could not restore the pre-existing .gitignore; resolve manually"
}

configure_workspace() {
    info "Applying maintainer role"
    run git config --local beads.role maintainer

    info "Configuring private JSONL export"
    run bd config set export.path issues.jsonl
    run bd config set export.auto true
    run bd config set import.path issues.jsonl
    run bd config set import.auto true

    # Never true for either profile here: publishing the export is a separate,
    # explicitly reviewed decision, and in local mode it must never happen.
    run bd config set export.git-add false
    run bd hooks install
}

# The template ships in the beads-solo skill. Look beside this script first
# (a repository checkout, or a stow tree of one), then in global skill
# installations.
prime_template() {
    local script_dir candidate
    local candidates=()

    if [[ -n "${BEADS_SOLO_PRIME_TEMPLATE:-}" ]]; then
        candidates+=("$BEADS_SOLO_PRIME_TEMPLATE")
    else
        script_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
        candidates+=("$script_dir/../.agents/skills/beads-solo/assets/PRIME.md")
        if [[ -n "${HOME:-}" ]]; then
            candidates+=(
                "$HOME/.agents/skills/beads-solo/assets/PRIME.md"
                "$HOME/.claude/skills/beads-solo/assets/PRIME.md"
            )
        fi
    fi

    for candidate in "${candidates[@]}"; do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# The workspace bd actually uses. In a linked worktree 'bd init' can resolve
# to another checkout's .beads/, which is where bd prime then looks.
beads_workspace() {
    local path
    path=$(bd where --json 2>/dev/null |
               python3 -c 'import json,sys; print(json.load(sys.stdin).get("path",""))' \
               2>/dev/null) || path=""
    printf '%s\n' "${path:-$ROOT/.beads}"
}

# Print a problem with PRIME.md, or nothing when it matches the template.
# Only ever a warning: bd works without it, and a stricter --check would
# stop agents in every enrollment made before the file existed.
prime_problem() {
    local template prime
    prime="$(beads_workspace)/$PRIME_NAME"
    if ! template=$(prime_template); then
        echo "beads-solo PRIME.md template not found, so $prime was not checked. Set BEADS_SOLO_PRIME_TEMPLATE"
    elif [[ ! -f "$prime" ]]; then
        echo "$prime is missing, so bd prime does not tell agents to load the Beads skills. Run 'bd-enroll-solo --repair-prime --yes'"
    elif ! cmp -s "$template" "$prime"; then
        echo "$prime differs from the beads-solo template. Run 'bd-enroll-solo --repair-prime --yes' to replace it"
    fi
}

install_prime() {
    local template prime
    template=$(prime_template) ||
        fail "beads-solo PRIME.md template not found. Set BEADS_SOLO_PRIME_TEMPLATE
       to the assets/PRIME.md file of the beads-solo skill."
    prime="$(beads_workspace)/$PRIME_NAME"

    info "Installing $prime from $template"
    run cp -- "$template" "$prime"

    # In the local profile .beads/ is excluded, so the file stays invisible.
    # A workspace in another checkout is that checkout's to commit.
    if [[ "$LOCAL_MODE" != true && "$prime" == "$ROOT"/* ]]; then
        run git add -- "$prime"
    fi
}

verify_enrollment() {
    if [[ "$DRY_RUN" == true ]]; then
        info "Dry run complete; no changes were made"
        return 0
    fi

    info "Verifying enrollment"

    local link privacy_problem
    for link in "${BEADS_SKILL_LINKS[@]}"; do
        is_beads_skill "$ROOT/$link" ||
            fail "$link is missing or is not a valid Beads skill"
        if privacy_problem=$(skill_link_privacy_problem "$link"); then
            fail "$privacy_problem"
        fi
    done

    local mode
    mode=$(bd context --json 2>/dev/null |
               python3 -c 'import json,sys; print(json.load(sys.stdin).get("dolt_mode",""))' \
               2>/dev/null) || mode=""
    [[ "$mode" == "server" ]] ||
        fail "workspace is not in server mode (got: ${mode:-unknown})"

    [[ "$(git config --local --get beads.role)" == maintainer ]] ||
        fail "beads.role is not pinned to maintainer"

    local remote_problems
    remote_problems=$(dolt_remote_problems)
    [[ -z "$remote_problems" ]] || fail "$remote_problems"

    if [[ "$LOCAL_MODE" == true ]]; then
        [[ "$(git config --local --get beads.solo.local)" == true ]] ||
            fail "beads.solo.local opt-in is not recorded"

        bd memories --json 2>/dev/null | grep -Fq "$MEMORY_KEY" ||
            warn "policy memory '$MEMORY_KEY' not found in 'bd memories'"

        # The defining invariant of local mode: 'git status' must be
        # byte-for-byte identical to what it printed before enrollment.
        # Comparing the whole status, rather than just the Beads paths,
        # catches any stray artifact written outside .beads/ as well.
        local status_after
        status_after=$(git status --porcelain --untracked-files=all 2>/dev/null || true)

        if [[ "$status_after" != "$STATUS_BEFORE" ]]; then
            fail "local enrollment changed 'git status'.
       Before:
${STATUS_BEFORE:-  (clean)}
       After:
${status_after:-  (clean)}"
        fi

        info "Verified: 'git status' is unchanged; Git sees no trace"
    else
        git ls-files --error-unmatch -- .beads-solo >/dev/null 2>&1 ||
            fail ".beads-solo marker is not tracked"

        if instruction_files_diverged; then
            fail "tracked AGENTS.md and CLAUDE.md diverged during enrollment"
        fi
    fi
}

# Validate an existing enrollment and print the active profile.
#
# This is the whole of the beads-solo skill's per-invocation validation. The
# skill runs exactly this and reads the exit status; it must never reproduce
# these checks as separate commands for an agent to interpret, because each
# such step is an opportunity to misread output or skip a check.
#
# Exit status:
#   0  enrolled and valid; profile printed to stdout as "profile: tracked|local"
#   1  not enrolled, or the enrollment is malformed (including a Dolt remote
#      or sync.remote, which is reported even if the database is unopenable)
#   2  indeterminate: bd could not open the Beads database, so the
#      bd-backed settings were not validated and nothing should be changed
run_check() {
    local errors=()
    local warnings=()
    local profile=""

    require_command git
    require_command bd
    set_repository_context

    local local_opt_in tracked_marker=false
    local_opt_in=$(git config --local --get beads.solo.local 2>/dev/null || true)
    git ls-files --error-unmatch -- .beads-solo >/dev/null 2>&1 && tracked_marker=true

    if [[ "$local_opt_in" == true && "$tracked_marker" == true ]]; then
        fail "conflicting enrollment: both a tracked .beads-solo marker and
       'beads.solo.local' are present. Resolve before continuing."
    elif [[ "$local_opt_in" == true ]]; then
        profile=local
    elif [[ "$tracked_marker" == true ]]; then
        profile=tracked
    else
        echo "not enrolled: no beads-solo enrollment found in $ROOT" >&2
        echo "Run 'bd-enroll-solo --yes' (or '--local --yes') to enroll." >&2
        return 1
    fi

    [[ -d "$ROOT/.beads" ]] || errors+=("no .beads workspace directory")

    # First, and independent of the database: a remote derived from git
    # origin is what makes bd gate schema migrations, and so what makes the
    # database unopenable. Checking it later hid the cause behind exit 2.
    local problem
    while IFS= read -r problem; do
        [[ -z "$problem" ]] || errors+=("$problem")
    done < <(dolt_remote_problems)

    local mode
    mode=$(bd context --json 2>/dev/null |
               python3 -c 'import json,sys; print(json.load(sys.stdin).get("dolt_mode",""))' \
               2>/dev/null) || mode=""
    [[ "$mode" == "server" ]] ||
        errors+=("workspace is not in Dolt server mode (got: ${mode:-unknown})")

    [[ "$(git config --local --get beads.role 2>/dev/null)" == maintainer ]] ||
        errors+=("beads.role is not pinned to maintainer")

    # 'bd config get' opens the Dolt database even for keys that live in
    # config.yaml, so a stopped, locked, or sandboxed server makes it exit 1
    # with empty output. Reporting that as a wrong value sent agents off to
    # "repair" a setting that was already correct; name the real cause.
    local db_ok=true db_error="" git_add
    if git_add=$(bd config get export.git-add 2>&1); then
        [[ "$git_add" == *false* ]] ||
            errors+=("export.git-add is not false; the JSONL export may be staged")
    else
        db_ok=false
        db_error=${git_add%%$'\n'*}
    fi

    local link privacy_problem skill_path
    local skill_found=false
    for link in "${BEADS_SKILL_LINKS[@]}"; do
        if [[ ! -e "$ROOT/$link" && ! -L "$ROOT/$link" ]]; then
            continue
        fi
        if ! is_beads_skill "$ROOT/$link"; then
            errors+=("$link exists but is not a valid Beads skill")
        else
            skill_found=true
            if privacy_problem=$(skill_link_privacy_problem "$link"); then
                errors+=("$privacy_problem")
            fi
        fi
    done

    if [[ -n "${HOME:-}" ]]; then
        for skill_path in \
            "$HOME/.agents/skills/beads" \
            "$HOME/.claude/skills/beads"; do
            if is_beads_skill "$skill_path"; then
                skill_found=true
                break
            fi
        done
    fi

    if [[ "$skill_found" != true ]]; then
        errors+=("no valid Beads skill found in project or global skill locations")
    fi

    if [[ -d "$ROOT/.beads" ]]; then
        problem=$(prime_problem)
        [[ -z "$problem" ]] || warnings+=("$problem")
    fi

    if [[ "$profile" == local ]]; then
        # The defining invariant: no Beads artifact may be visible to Git.
        local visible
        visible=$(git status --porcelain --untracked-files=all -- \
                      .beads .beads-solo "${BEADS_SKILL_LINKS[@]}" \
                      2>/dev/null || true)
        [[ -z "$visible" ]] ||
            errors+=("Beads artifacts are visible to Git:
    ${visible//$'\n'/$'\n'    }")

        local staged
        staged=$(git diff --cached --name-only -- .beads .beads-solo \
                     "${BEADS_SKILL_LINKS[@]}" 2>/dev/null || true)
        [[ -z "$staged" ]] ||
            errors+=("Beads artifacts are staged: ${staged//$'\n'/, }")

        if [[ "$db_ok" == true ]] &&
               ! bd memories --json 2>/dev/null | grep -Fq "$MEMORY_KEY"; then
            errors+=("policy memory '$MEMORY_KEY' is missing; run 'bd remember'")
        fi
    else
        [[ -f "$ROOT/.beads-solo" && ! -L "$ROOT/.beads-solo" &&
               ! -s "$ROOT/.beads-solo" ]] ||
            errors+=(".beads-solo must be a tracked, empty, regular file")

        if ! policy_declaration_present; then
            errors+=("AGENTS.md lacks the beads-solo policy declaration")
        elif ! grep -Fq "$POLICY_MARKER" "$ROOT/AGENTS.md"; then
            warnings+=("AGENTS.md has the old beads-solo declaration, which does not name beads-best-practices. Replace its first paragraph with: $(policy_text | sed -n 3,4p | paste -sd ' ')")
        fi

        if instruction_files_diverged; then
            errors+=("tracked AGENTS.md and CLAUDE.md differ")
        fi
    fi

    if [[ ${#warnings[@]} -gt 0 ]]; then
        echo "beads-solo warnings ($profile profile):" >&2
        printf '  - %s\n' "${warnings[@]}" >&2
    fi

    if [[ ${#errors[@]} -gt 0 ]]; then
        echo "beads-solo enrollment is malformed ($profile profile):" >&2
        printf '  - %s\n' "${errors[@]}" >&2
        return 1
    fi

    if [[ "$db_ok" != true ]]; then
        cat >&2 <<EOF
beads-solo enrollment could not be validated ($profile profile):
  bd could not open the Beads database, so export.git-add and the policy
  memory were not checked. Nothing is known to be malformed.
  ($db_error)

  Usual causes: the Dolt server is stopped, still starting, or holding a
  lock, or this process is sandboxed without access to the server's socket
  or network. Rerun this check from a process that can reach the server,
  for example outside the sandbox or with the same permissions 'bd' normally
  has. Do NOT run 'bd config set' or any other repair: the settings are
  unread, not wrong.
EOF
        return 2
    fi

    echo "profile: $profile"
    return 0
}

report() {
    [[ "$DRY_RUN" == true ]] && return 0

    echo
    info "Enrollment complete"

    if [[ "$LOCAL_MODE" == true ]]; then
        cat <<EOF

Profile:      local (invisible to Git)
Opt-in:       git config --local beads.solo.local
Policy:       Beads memory '$MEMORY_KEY' (injected by 'bd prime')
Excluded via: .git/info/exclude

Nothing was staged or committed. Do not commit .beads/ or .beads-solo, and
do not add the policy to a tracked AGENTS.md or CLAUDE.md.
EOF
    else
        cat <<'EOF'

Profile: tracked

'bd init' committed the enrollment (.beads-solo, AGENTS.md, CLAUDE.md,
.beads/ and agent integration files) as "bd init: initialize beads issue
tracking"; it offers no way to skip that commit. The export settings applied
afterwards (.beads/config.yaml) and .beads/PRIME.md are staged but NOT
committed.

Review AGENTS.md now, then amend or follow up that commit as you see fit.
EOF
    fi

    echo
    echo "Pushing Git branches and Dolt state remains prohibited unless you"
    echo "explicitly request it."
}

main() {
    parse_args "$@"

    local modes=0
    [[ "$CHECK_MODE" == true ]] && modes=$((modes + 1))
    [[ "$REPAIR_SKILLS" == true ]] && modes=$((modes + 1))
    [[ "$REPAIR_REMOTE" == true ]] && modes=$((modes + 1))
    [[ "$REPAIR_PRIME" == true ]] && modes=$((modes + 1))
    [[ $modes -le 1 ]] ||
        fail "--check, --repair-skills, --repair-remote and --repair-prime cannot be combined"
    if [[ "$CHECK_MODE" == true ]]; then
        run_check
        return $?
    fi

    if [[ "$YES" != true && "$DRY_RUN" != true ]]; then
        usage >&2
        fail "refusing to enroll without --yes (or use --dry-run)"
    fi

    if [[ "$REPAIR_SKILLS" == true ]]; then
        check_repair_prerequisites skills
        info "Repository: $ROOT"
        info "Repairing repository-local Beads skill links"
        prepare_beads_skill_links
        install_beads_skill_links
        if [[ "$DRY_RUN" == true ]]; then
            info "Dry run complete; no changes were made"
        else
            run_check
        fi
        return 0
    fi

    if [[ "$REPAIR_REMOTE" == true ]]; then
        check_repair_prerequisites remote
        info "Repository: $ROOT"
        info "Removing the Dolt remote and sync target beads-solo must not have"
        disable_sync_remote
        remove_dolt_origin_remote
        if [[ "$DRY_RUN" == true ]]; then
            info "Dry run complete; no changes were made"
        else
            run_check
        fi
        return 0
    fi

    if [[ "$REPAIR_PRIME" == true ]]; then
        check_repair_prerequisites prime
        info "Repository: $ROOT"
        install_prime
        if [[ "$DRY_RUN" == true ]]; then
            info "Dry run complete; no changes were made"
        else
            run_check
        fi
        return 0
    fi

    check_prerequisites
    check_instruction_files

    [[ -n "$PREFIX" ]] || PREFIX=$(infer_prefix_from_cwd)
    [[ -n "$PREFIX" ]] || fail "could not infer an issue prefix; pass --prefix"

    info "Repository: $ROOT"
    info "Profile:    $([[ "$LOCAL_MODE" == true ]] && echo local || echo tracked)"
    info "Prefix:     $PREFIX"

    prepare_beads_skill_links

    install_beads_skill_links
    record_opt_in
    install_policy_declaration
    ensure_claude_md_symlink
    initialize_workspace
    remove_dolt_origin_remote
    install_local_memory
    configure_workspace
    install_prime
    # After all bd commands, since 'bd hooks install' may also touch ignores.
    absorb_bd_gitignore
    verify_enrollment
    report
}

main "$@"
